{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huntgraph.io/schema/detection.schema.json",
  "title": "HuntGraph agentic threat-hunting detection knowledge",
  "description": "One file = one hunting hypothesis. Structural contract only; semantic rules (MITRE existence, evidence referential integrity, query dialect) are enforced by tools/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "version",
    "info",
    "mitre",
    "hypothesis",
    "requires",
    "query",
    "evidence"
  ],
  "properties": {
    "type": {
      "const": "detection"
    },
    "id": {
      "type": "string",
      "pattern": "^hg-(win|lin|mac|any|cloud|net|k8s|esxi)-[a-z0-9]+(-[a-z0-9]+)*-t\\d{4}(-\\d{3})?$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "severity",
        "author",
        "tags",
        "references"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 8,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 40
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "mitre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tactics",
        "techniques",
        "sub_techniques",
        "detection_strategies",
        "analytics",
        "platforms",
        "data_sources",
        "data_components"
      ],
      "properties": {
        "tactics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TA\\d{4}$"
          }
        },
        "techniques": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T\\d{4}$"
          }
        },
        "sub_techniques": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T\\d{4}\\.\\d{3}$"
          }
        },
        "detection_strategies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DET\\d{4}$"
          }
        },
        "analytics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AN\\d{4}$"
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Windows",
              "Linux",
              "macOS",
              "ESXi",
              "Containers",
              "IaaS",
              "SaaS",
              "Identity Provider",
              "Office Suite",
              "Network Devices"
            ]
          }
        },
        "data_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "data_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "attacker_behavior",
        "legitimate_behavior",
        "risk_indicator"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 60
        },
        "attacker_behavior": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "legitimate_behavior": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "risk_indicator": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platforms",
        "connectors",
        "logs"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "linux",
              "macos",
              "esxi",
              "containers",
              "iaas",
              "saas",
              "identity-provider",
              "office-suite",
              "network-devices"
            ]
          }
        },
        "connectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "crowdstrike-ngsiem",
              "wazuh"
            ]
          }
        },
        "logs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "event_types",
              "fields"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
              },
              "event_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "fields": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    },
                    "description": "Legacy: vendor field names. Migrated files use the map form."
                  },
                  {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "logical name -> vendor field name."
                  }
                ]
              },
              "connector": {
                "enum": [
                  "crowdstrike-ngsiem",
                  "wazuh"
                ],
                "description": "Which connector this telemetry comes from. Absent means crowdstrike-ngsiem (legacy, pre-migration)."
              }
            }
          }
        }
      }
    },
    "query": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "language",
              "cases"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "crowdstrike"
                ]
              },
              "language": {
                "enum": [
                  "cql"
                ]
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "purpose",
                    "query",
                    "filters",
                    "baseline"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 6
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 20
                    },
                    "query": {
                      "type": "string",
                      "minLength": 20
                    },
                    "filters": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "include",
                        "exclude"
                      ],
                      "properties": {
                        "include": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "exclude": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "baseline": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "required",
                        "window",
                        "compare"
                      ],
                      "properties": {
                        "required": {
                          "type": "boolean"
                        },
                        "window": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^\\d+[mhdw]$"
                        },
                        "compare": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "host",
                              "user",
                              "parent_process",
                              "process",
                              "command_line",
                              "path",
                              "module",
                              "domain",
                              "remote_address",
                              "organization"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "language",
              "ruleset",
              "cases",
              "not_portable"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "wazuh"
                ]
              },
              "language": {
                "enum": [
                  "wazuh-rules"
                ]
              },
              "ruleset": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "base_id",
                  "group",
                  "lists"
                ],
                "properties": {
                  "base_id": {
                    "type": "integer",
                    "minimum": 100000,
                    "maximum": 120000
                  },
                  "group": {
                    "type": "string",
                    "minLength": 3
                  },
                  "lists": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "purpose"
                      ],
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "purpose": {
                          "type": "string",
                          "minLength": 10
                        }
                      }
                    }
                  }
                }
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "purpose",
                    "covers",
                    "rule",
                    "correlation",
                    "limitations"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 6
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 20
                    },
                    "covers": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                      "description": "The cql case id this rule mirrors."
                    },
                    "rule": {
                      "type": "string",
                      "minLength": 40
                    },
                    "correlation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "frequency",
                        "timeframe",
                        "same_field"
                      ],
                      "properties": {
                        "frequency": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 2
                        },
                        "timeframe": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1
                        },
                        "same_field": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "not_portable": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "case",
                    "reason"
                  ],
                  "properties": {
                    "case": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 30
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "supporting",
        "contradicting",
        "risk_logic",
        "verdict",
        "false_positive"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "supporting": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "contradicting": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "risk_logic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "supporting",
            "contradicting"
          ],
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/evidenceId"
              }
            },
            "supporting": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "any",
                "all"
              ],
              "properties": {
                "any": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/evidenceId"
                  }
                },
                "all": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/evidenceId"
                  }
                }
              }
            },
            "contradicting": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "any",
                "all"
              ],
              "properties": {
                "any": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/evidenceId"
                  }
                },
                "all": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/evidenceId"
                  }
                }
              }
            }
          }
        },
        "verdict": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low_risk_when",
            "suspicious_when",
            "high_risk_when"
          ],
          "properties": {
            "low_risk_when": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/evidenceId"
              }
            },
            "suspicious_when": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/evidenceId"
              }
            },
            "high_risk_when": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/evidenceId"
              }
            }
          }
        },
        "false_positive": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition",
              "explanation"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 15
              },
              "explanation": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "source",
        "field",
        "indicates"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidenceId"
        },
        "name": {
          "type": "string",
          "minLength": 6
        },
        "description": {
          "type": "string",
          "minLength": 25
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "field": {
          "type": "string",
          "minLength": 2
        },
        "indicates": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        }
      }
    }
  }
}
